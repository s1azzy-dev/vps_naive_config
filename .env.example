# MVP: Ubuntu 26.04 LTS amd64, IPv4 SSH. Ports 80/443 are reserved for Caddy.
VPS_HOST=
VPS_PORT=22
VPS_BOOTSTRAP_USER=root
VPS_USER=slazzy

# Use absolute paths. SSH_PUBLIC_KEY defaults to SSH_PRIVATE_KEY + ".pub".
SSH_PRIVATE_KEY=
SSH_PUBLIC_KEY=

# Public gateway identity. DOMAIN must have matching A records and no AAAA.
DOMAIN=
ACME_EMAIL=

# Deployment source. No HTTPS userinfo/tokens; private repos use an SSH deploy key.
GATEWAY_REPOSITORY=https://github.com/s1azzy-dev/vps_naive_config.git
GATEWAY_REF=main

# Optional. Set both values to restore fixed credentials, or leave both empty
# and let provisioning generate them once.
NAIVE_USER=
NAIVE_PASSWORD=
